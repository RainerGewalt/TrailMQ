# TrailMQ environment variables
# Copy to .env and uncomment/adjust as needed.
# Loaded automatically by the CLI before running docker compose.

# --------------------------------------------------------------------
# Docker image tags
# --------------------------------------------------------------------
# Pin these to released versions once available:
#   TRAILMQ_BACKEND_IMAGE=rainergewalt/trailmq-backend:2.0.0
#   TRAILMQ_FRONTEND_IMAGE=rainergewalt/trailmq-frontend:2.0.0
#
# Defaults used when unset:
#   TRAILMQ_BACKEND_IMAGE=rainergewalt/trailmq-backend:latest
#   TRAILMQ_FRONTEND_IMAGE=rainergewalt/trailmq-frontend:latest
#   TRAILMQ_NGINX_IMAGE=nginx:stable-alpine

#TRAILMQ_BACKEND_IMAGE=rainergewalt/trailmq-backend:latest
#TRAILMQ_FRONTEND_IMAGE=rainergewalt/trailmq-frontend:latest
#TRAILMQ_NGINX_IMAGE=nginx:stable-alpine

# --------------------------------------------------------------------
# Host ports
# --------------------------------------------------------------------
# Use these when port 80 or 8883 is already in use on your machine.
# After changing them, restart with: ./trailmq down && ./trailmq start
#
#TRAILMQ_HTTP_PORT=8080
#TRAILMQ_MQTT_TLS_PORT=8884
