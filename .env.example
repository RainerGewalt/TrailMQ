# TrailMQ environment variables
# Copy to .env and uncomment/adjust as needed.
# Loaded automatically by the CLI before running docker compose.

# --------------------------------------------------------------------
# Docker image tags
# --------------------------------------------------------------------
# Leave these unset to run the release this checkout belongs to. Its version
# comes from release.yaml — `./trailmq version` prints the images it resolves
# to — so no tag is repeated here that could fall behind it.
#
# Set them only to pin a different published release, and replace <version>
# with that release. Backend and frontend ship as one release; never mix their
# versions.
#
# The proxy runs unprivileged and listens on 8080 inside its container. If you
# override TRAILMQ_NGINX_IMAGE with a stock nginx image, that image runs as root
# and serves on port 80, so the recipe's port mapping and its read-only root
# filesystem will no longer match it.

#TRAILMQ_BACKEND_IMAGE=rainergewalt/trailmq-backend:<version>
#TRAILMQ_FRONTEND_IMAGE=rainergewalt/trailmq-frontend:<version>

# --------------------------------------------------------------------
# Host ports
# --------------------------------------------------------------------
# Use these when port 80 or 8883 is already in use on your machine.
# After changing them, restart with: ./trailmq down && ./trailmq start
#
#TRAILMQ_HTTP_PORT=8080
#TRAILMQ_MQTT_TLS_PORT=8884
